// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js" // Nota: en Prisma 7 se recomienda "prisma-client" en vez de "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  quantity   Int         @default(0)
  price      Int         @default(999)
  createdAt  DateTime    @default(now())
  category   Category    @relation(fields: [categoryId], references: [id])
  categoryId Int
  orderItems OrderItem[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

// NUEVA ENTIDAD: User
model User {
  id     Int     @id @default(autoincrement())
  name   String
  email  String  @unique
  orders Order[] // Un usuario puede tener muchas órdenes
}

// NUEVA ENTIDAD: Order
model Order {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  items OrderItem[] // Una orden tiene muchos items
}

// NUEVA ENTIDAD: OrderItem (Tabla intermedia)
model OrderItem {
  id       Int @id @default(autoincrement())
  quantity Int @default(1)
  price    Int // Precio al momento de la compra

  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int
}
